{
  "name": "article-processor-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Article Processor",
  "author": "Article Processor",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.articleprocessor.desktop",
    "productName": "Article Processor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "assets/**/*",
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../services/api/dist/article-processor-api",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web/.next/standalone",
        "to": "web",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web/.next/static",
        "to": "web/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../web/public",
        "to": "web/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Office",
      "target": [
        "AppImage",
        "tar.gz"
      ]
    }
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  }
}
