# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.sqlite3

# ── Storage ─────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# ── Scholarly Sources (backend only, optional) ──────────────────────────
# OpenReview may challenge unauthenticated PDF downloads. An access token is
# preferred when present; otherwise the API signs in once per import with the
# username/password. Configure these in Settings → General when possible.
OPENREVIEW_USERNAME=
OPENREVIEW_PASSWORD=
OPENREVIEW_ACCESS_TOKEN=

# ── LLM Provider ────────────────────────────────────────────────────────
# Provider: openai | anthropic | custom
LLM_PROVIDER=openai

# Custom LLM (when LLM_PROVIDER=custom)
# Protocol: openai | anthropic | responses (OpenAI Responses API, /v1/responses)
LLM_CUSTOM_PROTOCOL=openai
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
LLM_CUSTOM_MODEL=

# OpenAI (used when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embedding Provider ──────────────────────────────────────────────────
# Provider: openai | custom
EMBEDDING_PROVIDER=openai

# Custom embeddings (when EMBEDDING_PROVIDER=custom)
EMBEDDING_CUSTOM_BASE_URL=
EMBEDDING_CUSTOM_API_KEY=
EMBEDDING_CUSTOM_MODEL=

# OpenAI embeddings model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Behaviour ───────────────────────────────────────────────────────────
# Set to true for offline regex-based extraction (no API key needed)
USE_MOCK_AI=true

# ── Parser ──────────────────────────────────────────────────────────────
# Priority: mineru_only | mineru_first | docling | pypdf | ocr
# "mineru_only" (default) is strict: PDF parsing fails with an error unless
# MinerU is installed or configured (local install, remote API, or sidecar).
# "mineru_first" prefers MinerU but gracefully falls back to Docling, then pypdf.
PARSER_PRIORITY=mineru_only

# ── MinerU API ──────────────────────────────────────────────────────────
# Parse PDFs via a remote MinerU service instead of a local install.
# Enable with MINERU_API_ENABLED=true (default false).
# Mode "cloud" = MinerU Precision API at https://mineru.net (needs a token).
# Mode "selfhosted" = your own mineru-api service (MINERU_API_BASE_URL points
# at it, no token required).
MINERU_API_ENABLED=false
MINERU_API_MODE=cloud
MINERU_API_KEY=
MINERU_API_BASE_URL=https://mineru.net
# Model: pipeline | vlm | MinerU-HTML
MINERU_API_MODEL=pipeline
MINERU_API_ENABLE_FORMULA=true
MINERU_API_IS_OCR=false
MINERU_API_LANGUAGE=en
MINERU_API_TIMEOUT_SECONDS=600
MINERU_API_POLL_INTERVAL=3

# ── Public API base URL ─────────────────────────────────────────────────
# Used to build absolute image URLs in parsed markdown. Override for
# Docker / remote deployments (defaults to http://localhost:8000).
API_BASE_URL=http://localhost:8000

# ── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
