# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.sqlite3

# ── Storage ─────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# ── LLM Provider ────────────────────────────────────────────────────────
# Provider: openai | anthropic | custom
LLM_PROVIDER=openai

# Custom LLM (when LLM_PROVIDER=custom)
# Protocol: openai | anthropic
LLM_CUSTOM_PROTOCOL=openai
LLM_CUSTOM_BASE_URL=
LLM_CUSTOM_API_KEY=
LLM_CUSTOM_MODEL=

# OpenAI (used when LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embedding Provider ──────────────────────────────────────────────────
# Provider: openai | custom
EMBEDDING_PROVIDER=openai

# Custom embeddings (when EMBEDDING_PROVIDER=custom)
EMBEDDING_CUSTOM_BASE_URL=
EMBEDDING_CUSTOM_API_KEY=
EMBEDDING_CUSTOM_MODEL=

# OpenAI embeddings model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Behaviour ───────────────────────────────────────────────────────────
# Set to true for offline regex-based extraction (no API key needed)
USE_MOCK_AI=true

# ── Parser ──────────────────────────────────────────────────────────────
# Priority: docling_first | pypdf | ocr
PARSER_PRIORITY=docling_first

# ── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
