# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/app.sqlite3

# ── Storage ─────────────────────────────────────────────────────────────
STORAGE_DIR=./storage
MAX_UPLOAD_MB=50

# ── AI Provider ─────────────────────────────────────────────────────────
# Provider type: openai | anthropic | custom_openai | custom_anthropic
AI_PROVIDER=openai

# OpenAI (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (used when AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Custom provider (used when AI_PROVIDER=custom_openai or custom_anthropic)
# Fill in your endpoint URL, key, and model name:
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL=

# ── Behaviour ───────────────────────────────────────────────────────────
# Set to true for offline regex-based extraction (no API key needed)
USE_MOCK_AI=true

# ── Frontend ────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
